# =============================================================================
# SHARED ENVIRONMENT TEMPLATE — web/ monorepo root
# Copy to .env and fill in values.
# These vars are shared across all apps in the monorepo.
# =============================================================================

# --- Local Development Infrastructure (Docker PostgreSQL) ---
# These are used for LOCAL development with Docker
# Fill in your values for local development (Steps 1-8 of deployment manual)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Database Connection (Production/Remote Deployment ONLY) ---
# ⚠️ LEAVE COMMENTED for local development (Steps 1-8)
# ⚠️ UNCOMMENT for production setup (Step 9-10 onwards)
# 
# When DATABASE_URL is set:
#   → Connects to REMOTE database (Supabase/production)
#   → Overrides local Docker PostgreSQL settings above
#   → All db:reset, db:seed, migrations affect REMOTE data
# 
# When DATABASE_URL is commented (local development):
#   → Uses local Docker PostgreSQL
#   → Safe to experiment without affecting production
#   → POSTGRES_* vars above are used instead
# 
# Get from: Supabase Project Settings → Database → Connection String (URI, Transaction mode)
# Format: postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
#
# DATABASE_URL=

# --- Authentication ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Stripe (Optional) ---
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
