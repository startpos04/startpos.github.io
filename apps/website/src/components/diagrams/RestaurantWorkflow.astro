---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`bg-white rounded-xl border border-slate-200 shadow-lg overflow-hidden ${className}`}>
  <svg viewBox="0 0 600 400" class="w-full h-full">
    <!-- Background -->
    <rect width="600" height="400" fill="#ffffff"/>
    
    <!-- Title -->
    <text x="300" y="30" font-family="system-ui" font-size="16" font-weight="600" fill="#1e293b" text-anchor="middle">Restaurant Order Management</text>
    
    <!-- Step 1: Take Order -->
    <rect x="50" y="60" width="100" height="70" rx="12" fill="#fff7ed" stroke="#ea580c"/>
    <text x="100" y="80" font-family="system-ui" font-size="20" text-anchor="middle">📝</text>
    <text x="100" y="100" font-family="system-ui" font-size="11" font-weight="600" fill="#ea580c" text-anchor="middle">Take Order</text>
    <text x="100" y="115" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Menu selection</text>
    <text x="100" y="125" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Customizations</text>
    
    <!-- Arrow 1 -->
    <path d="M 150 95 L 170 95" stroke="#10b981" stroke-width="2" fill="none" marker-end="url(#arrowhead)"/>
    
    <!-- Step 2: Kitchen Queue -->
    <rect x="180" y="60" width="100" height="70" rx="12" fill="#fef3c7" stroke="#f59e0b"/>
    <text x="230" y="80" font-family="system-ui" font-size="20" text-anchor="middle">👨‍🍳</text>
    <text x="230" y="100" font-family="system-ui" font-size="11" font-weight="600" fill="#d97706" text-anchor="middle">Kitchen Queue</text>
    <text x="230" y="115" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Order priority</text>
    <text x="230" y="125" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Prep time</text>
    
    <!-- Arrow 2 -->
    <path d="M 280 95 L 300 95" stroke="#10b981" stroke-width="2" fill="none" marker-end="url(#arrowhead)"/>
    
    <!-- Step 3: Cooking -->
    <rect x="310" y="60" width="100" height="70" rx="12" fill="#fef2f2" stroke="#dc2626"/>
    <text x="360" y="80" font-family="system-ui" font-size="20" text-anchor="middle">🔥</text>
    <text x="360" y="100" font-family="system-ui" font-size="11" font-weight="600" fill="#dc2626" text-anchor="middle">Cooking</text>
    <text x="360" y="115" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Status updates</text>
    <text x="360" y="125" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Ready alerts</text>
    
    <!-- Arrow 3 -->
    <path d="M 410 95 L 430 95" stroke="#10b981" stroke-width="2" fill="none" marker-end="url(#arrowhead)"/>
    
    <!-- Step 4: Ready -->
    <rect x="440" y="60" width="100" height="70" rx="12" fill="#f0fdf4" stroke="#16a34a"/>
    <text x="490" y="80" font-family="system-ui" font-size="20" text-anchor="middle">✅</text>
    <text x="490" y="100" font-family="system-ui" font-size="11" font-weight="600" fill="#16a34a" text-anchor="middle">Order Ready</text>
    <text x="490" y="115" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Customer notify</text>
    <text x="490" y="125" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Pickup/delivery</text>
    
    <!-- Service Types -->
    <text x="300" y="170" font-family="system-ui" font-size="14" font-weight="600" fill="#1e293b" text-anchor="middle">Service Options</text>
    
    <!-- Dine In -->
    <rect x="80" y="190" width="120" height="60" rx="8" fill="#e0f2fe" stroke="#0284c7"/>
    <text x="140" y="210" font-family="system-ui" font-size="18" text-anchor="middle">🪑</text>
    <text x="140" y="228" font-family="system-ui" font-size="11" font-weight="600" fill="#0284c7" text-anchor="middle">Dine-In</text>
    <text x="140" y="242" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Table service</text>
    
    <!-- Takeout -->
    <rect x="240" y="190" width="120" height="60" rx="8" fill="#fdf4ff" stroke="#a855f7"/>
    <text x="300" y="210" font-family="system-ui" font-size="18" text-anchor="middle">🥡</text>
    <text x="300" y="228" font-family="system-ui" font-size="11" font-weight="600" fill="#a855f7" text-anchor="middle">Takeout</text>
    <text x="300" y="242" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Quick pickup</text>
    
    <!-- Delivery -->
    <rect x="400" y="190" width="120" height="60" rx="8" fill="#fffbeb" stroke="#f59e0b"/>
    <text x="460" y="210" font-family="system-ui" font-size="18" text-anchor="middle">🛵</text>
    <text x="460" y="228" font-family="system-ui" font-size="11" font-weight="600" fill="#d97706" text-anchor="middle">Delivery</text>
    <text x="460" y="242" font-family="system-ui" font-size="9" fill="#64748b" text-anchor="middle">Driver tracking</text>
    
    <!-- Kitchen Display Features -->
    <rect x="50" y="280" width="500" height="80" rx="8" fill="#f8fafc"/>
    <text x="70" y="300" font-family="system-ui" font-size="12" font-weight="600" fill="#1e293b">Kitchen Display System:</text>
    <text x="70" y="315" font-family="system-ui" font-size="10" fill="#64748b">• Real-time order queue with preparation times</text>
    <text x="70" y="327" font-family="system-ui" font-size="10" fill="#64748b">• Color-coded priority (rush orders, VIP customers)</text>
    <text x="70" y="339" font-family="system-ui" font-size="10" fill="#64748b">• Special instructions and dietary restrictions</text>
    <text x="70" y="351" font-family="system-ui" font-size="10" fill="#64748b">• Automatic inventory deduction and low-stock alerts</text>
    
    <!-- Arrow marker definition -->
    <defs>
      <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#10b981"/>
      </marker>
    </defs>
  </svg>
</div>