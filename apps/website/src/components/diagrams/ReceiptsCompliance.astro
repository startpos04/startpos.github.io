---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden ${className}`}>
  <div class="p-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
          <span class="text-emerald-600 text-lg">🧾</span>
        </div>
        <h3 class="font-bold text-slate-900">Receipt Preview</h3>
      </div>
      <div class="flex gap-2">
        <button class="px-3 py-1 bg-emerald-500 text-white text-xs font-semibold rounded-md">Print Receipt</button>
        <button class="px-3 py-1 border border-slate-200 text-slate-600 text-xs font-semibold rounded-md">Email PDF</button>
      </div>
    </div>

    <!-- Receipt Mockup -->
    <div class="bg-white border-2 border-dashed border-slate-200 rounded-lg p-6 font-mono text-xs leading-relaxed">
      <!-- BIR Header -->
      <div class="text-center mb-4">
        <div class="font-bold text-sm">KAMAYAN SA PALAISDAAN</div>
        <div>Unit 2A Metrobank Bldg, Quezon Ave</div>
        <div>Quezon City, Metro Manila 1100</div>
        <div class="mt-2">
          <div><strong>TIN:</strong> 123-456-789-000</div>
          <div><strong>PTU No:</strong> FP012024-123-0001234-000</div>
        </div>
      </div>

      <!-- Transaction Details -->
      <div class="border-t border-dashed border-slate-300 pt-2 mb-2">
        <div class="flex justify-between">
          <span>OFFICIAL RECEIPT</span>
          <span><strong>OR# 000001245</strong></span>
        </div>
        <div class="flex justify-between">
          <span>Date/Time:</span>
          <span>Sep 19, 2026 2:45 PM</span>
        </div>
        <div class="flex justify-between">
          <span>Cashier:</span>
          <span>Maria Santos</span>
        </div>
        <div class="flex justify-between">
          <span>Customer:</span>
          <span>Juan Cruz (Senior)</span>
        </div>
      </div>

      <!-- Items -->
      <div class="border-t border-dashed border-slate-300 pt-2 mb-2">
        <div class="space-y-1">
          <div class="flex justify-between">
            <span>2x Beef Sisig Regular</span>
            <span>₱280.00</span>
          </div>
          <div class="flex justify-between">
            <span>1x Garlic Rice</span>
            <span>₱40.00</span>
          </div>
          <div class="flex justify-between">
            <span>2x Fresh Buko Juice</span>
            <span>₱90.00</span>
          </div>
        </div>
      </div>

      <!-- Totals and Discounts -->
      <div class="border-t border-dashed border-slate-300 pt-2 mb-2">
        <div class="flex justify-between">
          <span>Subtotal:</span>
          <span>₱410.00</span>
        </div>
        <div class="flex justify-between text-red-600">
          <span>Senior Citizen Discount (20%):</span>
          <span>-₱82.00</span>
        </div>
        <div class="flex justify-between">
          <span>VAT-Exempt Sales:</span>
          <span>₱292.86</span>
        </div>
        <div class="flex justify-between">
          <span>VAT Amount (12%):</span>
          <span>₱35.14</span>
        </div>
        <div class="flex justify-between font-bold border-t border-slate-300 pt-1 mt-1">
          <span>TOTAL AMOUNT:</span>
          <span>₱328.00</span>
        </div>
      </div>

      <!-- Payment -->
      <div class="border-t border-dashed border-slate-300 pt-2 mb-2">
        <div class="flex justify-between">
          <span>Cash Payment:</span>
          <span>₱500.00</span>
        </div>
        <div class="flex justify-between">
          <span>Change:</span>
          <span>₱172.00</span>
        </div>
      </div>

      <!-- BIR Compliance Footer -->
      <div class="border-t border-dashed border-slate-300 pt-2 text-center">
        <div class="mb-2">
          <div>VAT Reg TIN: 123-456-789-000</div>
          <div>MIN: 12345678901234567890</div>
          <div>SN: POS-2024-001</div>
        </div>
        <div class="text-[10px]">
          <div>This serves as your OFFICIAL RECEIPT</div>
          <div>"THIS RECEIPT/INVOICE SHALL BE VALID FOR</div>
          <div>FIVE (5) YEARS FROM THE DATE OF ATP"</div>
        </div>
      </div>

      <!-- QR Code Area -->
      <div class="text-center mt-3">
        <div class="inline-block w-16 h-16 bg-slate-100 border border-slate-300 rounded flex items-center justify-center">
          <div class="grid grid-cols-4 gap-0.5">
            {[...Array(16)].map((_, i) => (
              <div class={`w-1 h-1 ${Math.random() > 0.5 ? 'bg-slate-900' : 'bg-slate-100'}`} key={i}></div>
            ))}
          </div>
        </div>
        <div class="text-[10px] mt-1">BIR QR Code</div>
      </div>
    </div>

    <!-- Compliance Features -->
    <div class="mt-6 grid grid-cols-2 gap-4">
      <div class="bg-emerald-50 rounded-lg p-4">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-6 h-6 bg-emerald-100 rounded flex items-center justify-center">
            <span class="text-emerald-600 text-xs">🇵🇭</span>
          </div>
          <h4 class="font-semibold text-slate-900 text-sm">BIR Compliant</h4>
        </div>
        <ul class="text-xs text-slate-600 space-y-1">
          <li>• Sequential OR numbering</li>
          <li>• PTU & TIN validation</li>
          <li>• VAT computation modes</li>
          <li>• Senior/PWD discounts</li>
        </ul>
      </div>
      
      <div class="bg-blue-50 rounded-lg p-4">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-6 h-6 bg-blue-100 rounded flex items-center justify-center">
            <span class="text-blue-600 text-xs">📱</span>
          </div>
          <h4 class="font-semibold text-slate-900 text-sm">Multiple Formats</h4>
        </div>
        <ul class="text-xs text-slate-600 space-y-1">
          <li>• Thermal printer output</li>
          <li>• PDF generation</li>
          <li>• Email delivery</li>
          <li>• SMS integration ready</li>
        </ul>
      </div>
    </div>

    <!-- Regional Expansion -->
    <div class="mt-4 p-4 bg-gradient-to-r from-violet-50 to-blue-50 rounded-lg">
      <div class="flex items-center justify-between">
        <div>
          <h4 class="font-semibold text-slate-900 text-sm mb-1">Regional Expansion Ready</h4>
          <p class="text-xs text-slate-600">Built for Philippines, expanding to Singapore & Malaysia</p>
        </div>
        <div class="flex gap-1">
          <span class="px-2 py-1 bg-emerald-100 text-emerald-700 text-xs font-semibold rounded">PH Ready</span>
          <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded">GST Framework</span>
        </div>
      </div>
    </div>
  </div>
</div>