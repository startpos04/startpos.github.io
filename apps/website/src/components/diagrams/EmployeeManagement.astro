---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden ${className}`}>
  <div class="p-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
          <span class="text-emerald-600 text-lg">👤</span>
        </div>
        <h3 class="font-bold text-slate-900">Employee Management</h3>
      </div>
      <div class="flex gap-2">
        <button class="px-3 py-1 bg-emerald-500 text-white text-xs font-semibold rounded-md">+ Add Employee</button>
        <button class="px-3 py-1 border border-slate-200 text-slate-600 text-xs font-semibold rounded-md">Bulk Actions</button>
      </div>
    </div>

    <!-- Role Summary Cards -->
    <div class="grid grid-cols-4 gap-3 mb-6">
      <div class="bg-emerald-50 rounded-lg p-3 text-center">
        <div class="w-8 h-8 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-2">
          <span class="text-emerald-600 text-sm">👑</span>
        </div>
        <div class="text-lg font-bold text-slate-900">2</div>
        <div class="text-xs text-slate-600">Admins</div>
      </div>
      <div class="bg-blue-50 rounded-lg p-3 text-center">
        <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-2">
          <span class="text-blue-600 text-sm">👥</span>
        </div>
        <div class="text-lg font-bold text-slate-900">4</div>
        <div class="text-xs text-slate-600">Supervisors</div>
      </div>
      <div class="bg-violet-50 rounded-lg p-3 text-center">
        <div class="w-8 h-8 bg-violet-100 rounded-full flex items-center justify-center mx-auto mb-2">
          <span class="text-violet-600 text-sm">💰</span>
        </div>
        <div class="text-lg font-bold text-slate-900">8</div>
        <div class="text-xs text-slate-600">Cashiers</div>
      </div>
      <div class="bg-orange-50 rounded-lg p-3 text-center">
        <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-2">
          <span class="text-orange-600 text-sm">🍳</span>
        </div>
        <div class="text-lg font-bold text-slate-900">6</div>
        <div class="text-xs text-slate-600">Service Staff</div>
      </div>
    </div>

    <!-- Search and Filters -->
    <div class="flex gap-2 mb-4">
      <div class="flex-1 relative">
        <input type="text" placeholder="Search employees..." class="w-full pl-8 pr-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        <svg class="absolute left-2.5 top-2.5 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <select class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
        <option>All Roles</option>
        <option>Admin</option>
        <option>Supervisor</option>
        <option>Cashier</option>
        <option>Service Provider</option>
      </select>
      <select class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
        <option>All Branches</option>
        <option>Quezon Avenue</option>
        <option>SM Mall</option>
        <option>Makati CBD</option>
      </select>
    </div>

    <!-- Employee List -->
    <div class="space-y-3 mb-6">
      <!-- Employee 1 - Admin -->
      <div class="border border-slate-200 rounded-lg p-4 hover:bg-slate-50 transition-colors">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-emerald-100 to-green-100 rounded-full flex items-center justify-center">
              <span class="text-emerald-600 font-semibold text-sm">JS</span>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900">Juan Santos</h4>
              <p class="text-xs text-slate-600">juan.santos@kamayan.ph • Employee ID: EMP001</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-xs rounded font-semibold">Admin</span>
                <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-xs rounded">All Branches</span>
                <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded">Active</span>
              </div>
            </div>
          </div>
          <div class="text-right">
            <button class="p-1 text-slate-400 hover:text-slate-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
              </svg>
            </button>
            <div class="text-xs text-slate-500 mt-1">Last login: 2 hrs ago</div>
          </div>
        </div>
        
        <!-- Permissions Preview -->
        <div class="mt-3 pt-3 border-t border-slate-100">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold text-slate-700">Key Permissions:</span>
          </div>
          <div class="flex flex-wrap gap-1">
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Full System Access</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Manage Employees</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">View All Reports</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">System Settings</span>
          </div>
        </div>
      </div>

      <!-- Employee 2 - Supervisor -->
      <div class="border border-slate-200 rounded-lg p-4 hover:bg-slate-50 transition-colors">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-semibold text-sm">MC</span>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900">Maria Cruz</h4>
              <p class="text-xs text-slate-600">maria.cruz@kamayan.ph • Employee ID: EMP005</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-xs rounded font-semibold">Supervisor</span>
                <span class="px-2 py-0.5 bg-purple-100 text-purple-700 text-xs rounded">Quezon Avenue</span>
                <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded">Active</span>
              </div>
            </div>
          </div>
          <div class="text-right">
            <button class="p-1 text-slate-400 hover:text-slate-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
              </svg>
            </button>
            <div class="text-xs text-slate-500 mt-1">Last login: 30 min ago</div>
          </div>
        </div>
        
        <div class="mt-3 pt-3 border-t border-slate-100">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold text-slate-700">Key Permissions:</span>
          </div>
          <div class="flex flex-wrap gap-1">
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Approve Tasks</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Cash Reconciliation</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Inventory Adjustments</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Branch Reports</span>
          </div>
        </div>
      </div>

      <!-- Employee 3 - Cashier -->
      <div class="border border-slate-200 rounded-lg p-4 hover:bg-slate-50 transition-colors">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-violet-100 to-purple-100 rounded-full flex items-center justify-center">
              <span class="text-violet-600 font-semibold text-sm">AR</span>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900">Ana Reyes</h4>
              <p class="text-xs text-slate-600">ana.reyes@kamayan.ph • Employee ID: EMP012</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="px-2 py-0.5 bg-violet-100 text-violet-700 text-xs rounded font-semibold">Cashier</span>
                <span class="px-2 py-0.5 bg-purple-100 text-purple-700 text-xs rounded">Quezon Avenue</span>
                <span class="px-2 py-0.5 bg-yellow-100 text-yellow-700 text-xs rounded">On Shift</span>
              </div>
            </div>
          </div>
          <div class="text-right">
            <button class="p-1 text-slate-400 hover:text-slate-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
              </svg>
            </button>
            <div class="text-xs text-emerald-600 mt-1">Currently online</div>
          </div>
        </div>
        
        <div class="mt-3 pt-3 border-t border-slate-100">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold text-slate-700">Key Permissions:</span>
          </div>
          <div class="flex flex-wrap gap-1">
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Process Sales</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Handle Returns</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Customer Profiles</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Daily Reports</span>
          </div>
        </div>
      </div>

      <!-- Employee 4 - Service Staff -->
      <div class="border border-slate-200 rounded-lg p-4 hover:bg-slate-50 transition-colors">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-orange-100 to-red-100 rounded-full flex items-center justify-center">
              <span class="text-orange-600 font-semibold text-sm">RL</span>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900">Roberto Lopez</h4>
              <p class="text-xs text-slate-600">roberto.lopez@kamayan.ph • Employee ID: EMP018</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="px-2 py-0.5 bg-orange-100 text-orange-700 text-xs rounded font-semibold">Service Provider</span>
                <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-xs rounded">SM Mall</span>
                <span class="px-2 py-0.5 bg-red-100 text-red-700 text-xs rounded">Offline</span>
              </div>
            </div>
          </div>
          <div class="text-right">
            <button class="p-1 text-slate-400 hover:text-slate-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
              </svg>
            </button>
            <div class="text-xs text-slate-500 mt-1">Last login: 6 hrs ago</div>
          </div>
        </div>
        
        <div class="mt-3 pt-3 border-t border-slate-100">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold text-slate-700">Key Permissions:</span>
          </div>
          <div class="flex flex-wrap gap-1">
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Order Management</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Kitchen Orders</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Stock Tasks</span>
            <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">Basic Reports</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Permission Matrix Preview -->
    <div class="bg-slate-50 rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h4 class="font-semibold text-slate-900 text-sm">Permission Matrix Overview</h4>
        <button class="text-xs text-emerald-600 font-semibold hover:underline">View Full Matrix</button>
      </div>
      <div class="text-xs text-slate-600">
        <div class="grid grid-cols-4 gap-4">
          <div>
            <span class="font-semibold text-emerald-600">Admin:</span> Full system access, all permissions
          </div>
          <div>
            <span class="font-semibold text-blue-600">Supervisor:</span> Branch management, task approvals
          </div>
          <div>
            <span class="font-semibold text-violet-600">Cashier:</span> POS operations, customer management
          </div>
          <div>
            <span class="font-semibold text-orange-600">Service:</span> Order management, basic inventory
          </div>
        </div>
      </div>
    </div>
  </div>
</div>