---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`bg-white rounded-xl border border-slate-200 shadow-lg overflow-hidden ${className}`}>
  <svg viewBox="0 0 700 450" class="w-full h-full">
    <!-- Background -->
    <rect width="700" height="450" fill="#ffffff"/>
    
    <!-- Header -->
    <rect width="700" height="50" fill="#f8fafc"/>
    <rect x="0" y="49" width="700" height="1" fill="#e2e8f0"/>
    
    <!-- Title -->
    <text x="30" y="30" font-family="system-ui" font-size="16" font-weight="600" fill="#1e293b">Sales Reports</text>
    
    <!-- Date Range Picker -->
    <rect x="520" y="15" width="160" height="30" rx="6" fill="#f1f5f9" stroke="#e2e8f0"/>
    <text x="530" y="33" font-family="system-ui" font-size="11" fill="#64748b">📅 Last 30 days</text>
    <text x="665" y="33" font-family="system-ui" font-size="11" fill="#64748b">▼</text>
    
    <!-- KPI Cards Row -->
    <rect x="30" y="70" width="150" height="80" rx="12" fill="#f0fdf4" stroke="#16a34a"/>
    <text x="50" y="95" font-family="system-ui" font-size="12" font-weight="600" fill="#16a34a">Total Sales</text>
    <text x="50" y="120" font-family="system-ui" font-size="24" font-weight="700" fill="#1e293b">₱124,580</text>
    <text x="50" y="135" font-family="system-ui" font-size="10" fill="#16a34a">↗️ +12.5% vs last month</text>
    
    <rect x="200" y="70" width="150" height="80" rx="12" fill="#eff6ff" stroke="#3b82f6"/>
    <text x="220" y="95" font-family="system-ui" font-size="12" font-weight="600" fill="#3b82f6">Transactions</text>
    <text x="220" y="120" font-family="system-ui" font-size="24" font-weight="700" fill="#1e293b">1,247</text>
    <text x="220" y="135" font-family="system-ui" font-size="10" fill="#3b82f6">↗️ +8.3% vs last month</text>
    
    <rect x="370" y="70" width="150" height="80" rx="12" fill="#fdf4ff" stroke="#a855f7"/>
    <text x="390" y="95" font-family="system-ui" font-size="12" font-weight="600" fill="#a855f7">Avg. Order</text>
    <text x="390" y="120" font-family="system-ui" font-size="24" font-weight="700" fill="#1e293b">₱99.90</text>
    <text x="390" y="135" font-family="system-ui" font-size="10" fill="#a855f7">↗️ +3.8% vs last month</text>
    
    <rect x="540" y="70" width="130" height="80" rx="12" fill="#fffbeb" stroke="#f59e0b"/>
    <text x="560" y="95" font-family="system-ui" font-size="12" font-weight="600" fill="#d97706">Profit Margin</text>
    <text x="560" y="120" font-family="system-ui" font-size="24" font-weight="700" fill="#1e293b">34.2%</text>
    <text x="560" y="135" font-family="system-ui" font-size="10" fill="#d97706">↗️ +2.1% vs last month</text>
    
    <!-- Sales Chart -->
    <rect x="30" y="170" width="400" height="200" rx="8" fill="#f8fafc" stroke="#e2e8f0"/>
    <text x="50" y="195" font-family="system-ui" font-size="14" font-weight="600" fill="#1e293b">Daily Sales Trend</text>
    
    <!-- Chart bars -->
    <rect x="50" y="320" width="15" height="30" fill="#10b981"/>
    <rect x="70" y="310" width="15" height="40" fill="#10b981"/>
    <rect x="90" y="325" width="15" height="25" fill="#10b981"/>
    <rect x="110" y="300" width="15" height="50" fill="#10b981"/>
    <rect x="130" y="315" width="15" height="35" fill="#10b981"/>
    <rect x="150" y="305" width="15" height="45" fill="#10b981"/>
    <rect x="170" y="290" width="15" height="60" fill="#10b981"/>
    <rect x="190" y="295" width="15" height="55" fill="#10b981"/>
    <rect x="210" y="285" width="15" height="65" fill="#10b981"/>
    <rect x="230" y="280" width="15" height="70" fill="#10b981"/>
    <rect x="250" y="285" width="15" height="65" fill="#10b981"/>
    <rect x="270" y="290" width="15" height="60" fill="#10b981"/>
    <rect x="290" y="300" width="15" height="50" fill="#10b981"/>
    <rect x="310" y="295" width="15" height="55" fill="#10b981"/>
    <rect x="330" y="285" width="15" height="65" fill="#10b981"/>
    <rect x="350" y="275" width="15" height="75" fill="#10b981"/>
    <rect x="370" y="270" width="15" height="80" fill="#10b981"/>
    <rect x="390" y="265" width="15" height="85" fill="#10b981"/>
    
    <!-- Chart baseline -->
    <line x1="50" y1="350" x2="405" y2="350" stroke="#e2e8f0" stroke-width="1"/>
    
    <!-- Top Products -->
    <rect x="450" y="170" width="220" height="200" rx="8" fill="#f8fafc" stroke="#e2e8f0"/>
    <text x="470" y="195" font-family="system-ui" font-size="14" font-weight="600" fill="#1e293b">Top Products</text>
    
    <!-- Product list -->
    <rect x="470" y="210" width="180" height="30" fill="white"/>
    <text x="480" y="228" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">🥤 Coca Cola 500ml</text>
    <text x="640" y="228" font-family="system-ui" font-size="11" font-weight="600" fill="#10b981" text-anchor="end">₱1,250</text>
    
    <rect x="470" y="240" width="180" height="30" fill="white"/>
    <text x="480" y="258" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">🍟 French Fries Large</text>
    <text x="640" y="258" font-family="system-ui" font-size="11" font-weight="600" fill="#10b981" text-anchor="end">₱900</text>
    
    <rect x="470" y="270" width="180" height="30" fill="white"/>
    <text x="480" y="288" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">🍔 Premium Burger</text>
    <text x="640" y="288" font-family="system-ui" font-size="11" font-weight="600" fill="#10b981" text-anchor="end">₱765</text>
    
    <rect x="470" y="300" width="180" height="30" fill="white"/>
    <text x="480" y="318" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">🥪 Club Sandwich</text>
    <text x="640" y="318" font-family="system-ui" font-size="11" font-weight="600" fill="#10b981" text-anchor="end">₱625</text>
    
    <rect x="470" y="330" width="180" height="30" fill="white"/>
    <text x="480" y="348" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">🍕 Pizza Slice</text>
    <text x="640" y="348" font-family="system-ui" font-size="11" font-weight="600" fill="#10b981" text-anchor="end">₱520</text>
    
    <!-- Export Options -->
    <rect x="30" y="390" width="300" height="40" rx="8" fill="#f0fdf4" stroke="#10b981"/>
    <text x="50" y="410" font-family="system-ui" font-size="12" font-weight="600" fill="#14532d">Export Options:</text>
    
    <rect x="160" y="395" width="60" height="30" rx="6" fill="#10b981"/>
    <text x="190" y="413" font-family="system-ui" font-size="10" font-weight="500" fill="white" text-anchor="middle">PDF</text>
    
    <rect x="230" y="395" width="60" height="30" rx="6" fill="#f1f5f9" stroke="#e2e8f0"/>
    <text x="260" y="413" font-family="system-ui" font-size="10" font-weight="500" fill="#64748b" text-anchor="middle">CSV</text>
    
    <!-- Branch Comparison -->
    <rect x="350" y="390" width="320" height="40" rx="8" fill="#eff6ff" stroke="#3b82f6"/>
    <text x="370" y="405" font-family="system-ui" font-size="11" font-weight="600" fill="#1e4ed8">Branch Performance:</text>
    <text x="370" y="420" font-family="system-ui" font-size="10" fill="#1e4ed8">Main: ₱78K • Branch 2: ₱46K • Online: ₱12K</text>
    
    <rect x="620" y="395" width="40" height="30" rx="6" fill="#3b82f6"/>
    <text x="640" y="413" font-family="system-ui" font-size="10" font-weight="500" fill="white" text-anchor="middle">View</text>
  </svg>
</div>