---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`bg-white rounded-xl border border-slate-200 shadow-lg overflow-hidden ${className}`}>
  <svg viewBox="0 0 700 500" class="w-full h-full">
    <!-- Background -->
    <rect width="700" height="500" fill="#ffffff"/>
    
    <!-- Header -->
    <rect width="700" height="50" fill="#f8fafc"/>
    <rect x="0" y="49" width="700" height="1" fill="#e2e8f0"/>
    
    <!-- Title -->
    <text x="30" y="30" font-family="system-ui" font-size="16" font-weight="600" fill="#1e293b">Batch Preparation - Production Run</text>
    
    <!-- New Batch Button -->
    <rect x="550" y="15" width="120" height="30" rx="6" fill="#10b981"/>
    <text x="610" y="33" font-family="system-ui" font-size="11" font-weight="500" fill="white" text-anchor="middle">+ New Production</text>
    
    <!-- Recipe Selection -->
    <rect x="30" y="70" width="640" height="80" rx="8" fill="#f0fdf4" stroke="#dcfce7"/>
    <text x="45" y="90" font-family="system-ui" font-size="12" font-weight="600" fill="#15803d">Selected Recipe</text>
    
    <rect x="45" y="100" width="40" height="40" rx="8" fill="#dcfce7"/>
    <text x="65" y="125" font-family="system-ui" font-size="20" text-anchor="middle">🥪</text>
    
    <text x="100" y="115" font-family="system-ui" font-size="14" font-weight="600" fill="#1e293b">Premium Club Sandwich</text>
    <text x="100" y="130" font-family="system-ui" font-size="11" fill="#64748b">Batch Size: 20 units • Prep Time: 45 minutes • Shelf Life: 3 days</text>
    
    <text x="550" y="115" font-family="system-ui" font-size="11" fill="#64748b">Recipe Cost per Unit:</text>
    <text x="550" y="130" font-family="system-ui" font-size="14" font-weight="600" fill="#10b981">₱45.50</text>
    
    <!-- Bill of Materials -->
    <text x="30" y="175" font-family="system-ui" font-size="14" font-weight="600" fill="#1e293b">Bill of Materials (for 20 units)</text>
    
    <!-- Ingredients Table Header -->
    <rect x="30" y="185" width="640" height="30" fill="#f8fafc"/>
    <rect x="30" y="214" width="640" height="1" fill="#e2e8f0"/>
    
    <text x="50" y="203" font-family="system-ui" font-size="11" font-weight="600" fill="#475569">Ingredient</text>
    <text x="300" y="203" font-family="system-ui" font-size="11" font-weight="600" fill="#475569">Required</text>
    <text x="400" y="203" font-family="system-ui" font-size="11" font-weight="600" fill="#475569">Available</text>
    <text x="500" y="203" font-family="system-ui" font-size="11" font-weight="600" fill="#475569">Status</text>
    <text x="600" y="203" font-family="system-ui" font-size="11" font-weight="600" fill="#475569">Unit Cost</text>
    
    <!-- Ingredient Row 1 - Available -->
    <rect x="30" y="215" width="640" height="35" fill="white"/>
    <rect x="30" y="249" width="640" height="1" fill="#f1f5f9"/>
    
    <rect x="40" y="222" width="20" height="20" rx="4" fill="#fef3c7"/>
    <text x="50" y="234" font-family="system-ui" font-size="12" text-anchor="middle">🍞</text>
    <text x="70" y="230" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">White Bread Slices</text>
    <text x="70" y="242" font-family="system-ui" font-size="9" fill="#64748b">Fresh bread from bakery</text>
    
    <text x="300" y="235" font-family="system-ui" font-size="11" fill="#1e293b">60 pieces</text>
    <text x="400" y="235" font-family="system-ui" font-size="11" font-weight="500" fill="#16a34a">120 pieces</text>
    
    <rect x="500" y="227" width="50" height="14" rx="7" fill="#dcfce7"/>
    <text x="525" y="236" font-family="system-ui" font-size="9" font-weight="500" fill="#16a34a" text-anchor="middle">Available</text>
    
    <text x="600" y="235" font-family="system-ui" font-size="11" fill="#1e293b">₱180.00</text>
    
    <!-- Ingredient Row 2 - Low Stock -->
    <rect x="30" y="250" width="640" height="35" fill="white"/>
    <rect x="30" y="284" width="640" height="1" fill="#f1f5f9"/>
    
    <rect x="40" y="257" width="20" height="20" rx="4" fill="#fef3c7"/>
    <text x="50" y="269" font-family="system-ui" font-size="12" text-anchor="middle">🥓</text>
    <text x="70" y="265" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">Premium Bacon</text>
    <text x="70" y="277" font-family="system-ui" font-size="9" fill="#64748b">Imported smoked bacon</text>
    
    <text x="300" y="270" font-family="system-ui" font-size="11" fill="#1e293b">400g</text>
    <text x="400" y="270" font-family="system-ui" font-size="11" font-weight="500" fill="#f59e0b">450g</text>
    
    <rect x="500" y="262" width="60" height="14" rx="7" fill="#fef3c7"/>
    <text x="530" y="271" font-family="system-ui" font-size="9" font-weight="500" fill="#d97706" text-anchor="middle">Low Stock</text>
    
    <text x="600" y="270" font-family="system-ui" font-size="11" fill="#1e293b">₱560.00</text>
    
    <!-- Ingredient Row 3 - Available -->
    <rect x="30" y="285" width="640" height="35" fill="white"/>
    <rect x="30" y="319" width="640" height="1" fill="#f1f5f9"/>
    
    <rect x="40" y="292" width="20" height="20" rx="4" fill="#dcfce7"/>
    <text x="50" y="304" font-family="system-ui" font-size="12" text-anchor="middle">🥬</text>
    <text x="70" y="300" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">Fresh Lettuce</text>
    <text x="70" y="312" font-family="system-ui" font-size="9" fill="#64748b">Iceberg lettuce leaves</text>
    
    <text x="300" y="305" font-family="system-ui" font-size="11" fill="#1e293b">2 heads</text>
    <text x="400" y="305" font-family="system-ui" font-size="11" font-weight="500" fill="#16a34a">8 heads</text>
    
    <rect x="500" y="297" width="50" height="14" rx="7" fill="#dcfce7"/>
    <text x="525" y="306" font-family="system-ui" font-size="9" font-weight="500" fill="#16a34a" text-anchor="middle">Available</text>
    
    <text x="600" y="305" font-family="system-ui" font-size="11" fill="#1e293b">₱120.00</text>
    
    <!-- Production Details -->
    <rect x="30" y="340" width="300" height="140" rx="8" fill="#f8fafc" stroke="#e2e8f0"/>
    <text x="45" y="360" font-family="system-ui" font-size="12" font-weight="600" fill="#1e293b">Production Details</text>
    
    <text x="45" y="380" font-family="system-ui" font-size="11" fill="#64748b">Batch Quantity</text>
    <rect x="45" y="385" width="80" height="25" rx="4" fill="white" stroke="#e2e8f0"/>
    <text x="85" y="400" font-family="system-ui" font-size="12" fill="#1e293b" text-anchor="middle">20</text>
    <text x="135" y="400" font-family="system-ui" font-size="11" fill="#64748b">units</text>
    
    <text x="45" y="425" font-family="system-ui" font-size="11" fill="#64748b">Production Date</text>
    <text x="45" y="440" font-family="system-ui" font-size="11" font-weight="500" fill="#1e293b">Today, 2:30 PM</text>
    
    <text x="45" y="460" font-family="system-ui" font-size="11" fill="#64748b">Expiry Date</text>
    <text x="45" y="475" font-family="system-ui" font-size="11" font-weight="500" fill="#dc2626">Dec 22, 2024</text>
    
    <!-- Cost Summary -->
    <rect x="350" y="340" width="320" height="140" rx="8" fill="#f0fdf4" stroke="#dcfce7"/>
    <text x="365" y="360" font-family="system-ui" font-size="12" font-weight="600" fill="#15803d">Cost Summary</text>
    
    <text x="365" y="380" font-family="system-ui" font-size="11" fill="#64748b">Raw Materials</text>
    <text x="635" y="380" font-family="system-ui" font-size="11" fill="#1e293b" text-anchor="end">₱860.00</text>
    
    <text x="365" y="395" font-family="system-ui" font-size="11" fill="#64748b">Labour Cost (45 min)</text>
    <text x="635" y="395" font-family="system-ui" font-size="11" fill="#1e293b" text-anchor="end">₱112.50</text>
    
    <text x="365" y="410" font-family="system-ui" font-size="11" fill="#64748b">Overhead (15%)</text>
    <text x="635" y="410" font-family="system-ui" font-size="11" fill="#1e293b" text-anchor="end">₱145.88</text>
    
    <rect x="365" y="420" width="240" height="1" fill="#16a34a"/>
    <text x="365" y="440" font-family="system-ui" font-size="12" font-weight="600" fill="#15803d">Total Batch Cost</text>
    <text x="635" y="440" font-family="system-ui" font-size="12" font-weight="600" fill="#15803d" text-anchor="end">₱1,118.38</text>
    
    <text x="365" y="455" font-family="system-ui" font-size="11" fill="#64748b">Cost per Unit</text>
    <text x="635" y="455" font-family="system-ui" font-size="11" font-weight="500" fill="#15803d" text-anchor="end">₱55.92</text>
    
    <rect x="365" y="465" width="120" height="25" rx="4" fill="#16a34a"/>
    <text x="425" y="480" font-family="system-ui" font-size="11" font-weight="500" fill="white" text-anchor="middle">Start Production</text>
    
    <rect x="495" y="465" width="120" height="25" rx="4" fill="#f1f5f9" stroke="#e2e8f0"/>
    <text x="555" y="480" font-family="system-ui" font-size="11" font-weight="500" fill="#64748b" text-anchor="middle">Save as Draft</text>
  </svg>
</div>