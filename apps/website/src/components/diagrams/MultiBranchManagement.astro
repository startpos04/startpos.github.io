---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden ${className}`}>
  <div class="p-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
          <span class="text-emerald-600 text-lg">🏪</span>
        </div>
        <h3 class="font-bold text-slate-900">Multi-Branch Dashboard</h3>
      </div>
      <div class="flex gap-2">
        <button class="px-3 py-1 bg-emerald-500 text-white text-xs font-semibold rounded-md">+ Add Branch</button>
        <button class="px-3 py-1 border border-slate-200 text-slate-600 text-xs font-semibold rounded-md">Settings</button>
      </div>
    </div>

    <!-- Business Overview -->
    <div class="mb-6 p-4 bg-gradient-to-r from-emerald-50 to-blue-50 rounded-lg">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h4 class="font-bold text-slate-900">Kamayan Restaurant Group</h4>
          <p class="text-sm text-slate-600">3 active branches • Enterprise Plan</p>
        </div>
        <div class="text-right">
          <div class="text-lg font-bold text-slate-900">₱45,230</div>
          <div class="text-xs text-slate-600">Today's Total Sales</div>
        </div>
      </div>
      
      <div class="grid grid-cols-3 gap-3">
        <div class="text-center p-2 bg-white rounded">
          <div class="text-sm font-bold text-slate-900">152</div>
          <div class="text-xs text-slate-600">Total Transactions</div>
        </div>
        <div class="text-center p-2 bg-white rounded">
          <div class="text-sm font-bold text-emerald-600">98%</div>
          <div class="text-xs text-slate-600">System Uptime</div>
        </div>
        <div class="text-center p-2 bg-white rounded">
          <div class="text-sm font-bold text-blue-600">12</div>
          <div class="text-xs text-slate-600">Active Staff</div>
        </div>
      </div>
    </div>

    <!-- Branch Cards -->
    <div class="space-y-4 mb-6">
      <!-- Main Branch -->
      <div class="border-2 border-emerald-200 bg-emerald-50/30 rounded-lg p-4">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center">
              <span class="text-emerald-600 text-lg">🏢</span>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900">Quezon Avenue (Main)</h4>
              <p class="text-xs text-slate-600">123 Quezon Ave, QC • Since 2019</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-xs rounded">Main Branch</span>
                <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded">Online</span>
              </div>
            </div>
          </div>
          <button class="p-1 text-slate-400 hover:text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
            </svg>
          </button>
        </div>

        <div class="grid grid-cols-4 gap-3 mb-3">
          <div class="text-center">
            <div class="text-sm font-bold text-slate-900">₱22,450</div>
            <div class="text-xs text-slate-600">Today's Sales</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-slate-900">89</div>
            <div class="text-xs text-slate-600">Transactions</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-emerald-600">6</div>
            <div class="text-xs text-slate-600">Staff Online</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-blue-600">234</div>
            <div class="text-xs text-slate-600">Items in Stock</div>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex gap-2">
            <button class="px-2 py-1 bg-emerald-100 text-emerald-700 text-xs font-semibold rounded">View POS</button>
            <button class="px-2 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded">Reports</button>
          </div>
          <div class="text-xs text-slate-500">Last sync: 2 min ago</div>
        </div>
      </div>

      <!-- Branch 2 -->
      <div class="border border-slate-200 rounded-lg p-4">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
              <span class="text-blue-600 text-lg">🏪</span>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900">SM Mall Branch</h4>
              <p class="text-xs text-slate-600">Level 3, SM North EDSA • Since 2021</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-xs rounded">Food Court</span>
                <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded">Online</span>
              </div>
            </div>
          </div>
          <button class="p-1 text-slate-400 hover:text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
            </svg>
          </button>
        </div>

        <div class="grid grid-cols-4 gap-3 mb-3">
          <div class="text-center">
            <div class="text-sm font-bold text-slate-900">₱18,920</div>
            <div class="text-xs text-slate-600">Today's Sales</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-slate-900">45</div>
            <div class="text-xs text-slate-600">Transactions</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-emerald-600">4</div>
            <div class="text-xs text-slate-600">Staff Online</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-orange-600">89</div>
            <div class="text-xs text-slate-600">Items in Stock</div>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex gap-2">
            <button class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded">View POS</button>
            <button class="px-2 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded">Reports</button>
          </div>
          <div class="text-xs text-slate-500">Last sync: 5 min ago</div>
        </div>
      </div>

      <!-- Branch 3 - Offline -->
      <div class="border border-slate-200 bg-slate-50 rounded-lg p-4">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
              <span class="text-slate-600 text-lg">🏪</span>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900">Makati CBD</h4>
              <p class="text-xs text-slate-600">Ayala Center, Makati • Since 2023</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="px-2 py-0.5 bg-purple-100 text-purple-700 text-xs rounded">Business District</span>
                <span class="px-2 py-0.5 bg-yellow-100 text-yellow-700 text-xs rounded">Offline</span>
              </div>
            </div>
          </div>
          <button class="p-1 text-slate-400 hover:text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
            </svg>
          </button>
        </div>

        <div class="grid grid-cols-4 gap-3 mb-3">
          <div class="text-center">
            <div class="text-sm font-bold text-slate-500">₱3,860</div>
            <div class="text-xs text-slate-500">Today's Sales (cached)</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-slate-500">18</div>
            <div class="text-xs text-slate-500">Transactions (cached)</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-slate-500">2</div>
            <div class="text-xs text-slate-500">Staff (last known)</div>
          </div>
          <div class="text-center">
            <div class="text-sm font-bold text-slate-500">?</div>
            <div class="text-xs text-slate-500">Stock (pending sync)</div>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex gap-2">
            <button class="px-2 py-1 bg-slate-200 text-slate-500 text-xs font-semibold rounded" disabled>View POS</button>
            <button class="px-2 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded">Cached Reports</button>
          </div>
          <div class="text-xs text-orange-600">Last sync: 3 hours ago</div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-2 gap-4">
      <div class="p-4 bg-violet-50 rounded-lg">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-6 h-6 bg-violet-100 rounded flex items-center justify-center">
            <span class="text-violet-600 text-xs">📊</span>
          </div>
          <h4 class="font-semibold text-slate-900 text-sm">Consolidated Reports</h4>
        </div>
        <p class="text-xs text-slate-600 mb-3">View sales, inventory, and performance across all branches</p>
        <button class="w-full px-3 py-2 bg-violet-500 text-white text-xs font-semibold rounded">View All Reports</button>
      </div>
      
      <div class="p-4 bg-orange-50 rounded-lg">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-6 h-6 bg-orange-100 rounded flex items-center justify-center">
            <span class="text-orange-600 text-xs">🔄</span>
          </div>
          <h4 class="font-semibold text-slate-900 text-sm">Transfer Management</h4>
        </div>
        <p class="text-xs text-slate-600 mb-3">Move inventory between branches with approval workflows</p>
        <button class="w-full px-3 py-2 bg-orange-500 text-white text-xs font-semibold rounded">Manage Transfers</button>
      </div>
    </div>
  </div>
</div>