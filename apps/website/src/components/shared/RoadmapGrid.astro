---
import { ROADMAP_ITEMS } from '../../data/roadmap'
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {ROADMAP_ITEMS.map(item => (
    <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/8 transition-colors">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-3xl" aria-hidden="true">{item.icon}</span>
        <div>
          <h3 class="text-base font-bold text-white leading-tight">{item.title}</h3>
          <span class="text-xs font-semibold text-orange-400/80">{item.plan} — Coming soon</span>
        </div>
      </div>
      <p class="text-sm text-slate-400 leading-relaxed mb-4">{item.description}</p>
      <ul class="space-y-1.5">
        {item.bullets.map(bullet => (
          <li class="flex items-start gap-2 text-xs text-slate-500">
            <svg class="mt-0.5 shrink-0 text-orange-500/60" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>