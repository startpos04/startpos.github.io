---
import { APP_URL } from '../../constants'
import POSInterface from '../diagrams/POSInterface.astro'
---

<section class="relative overflow-hidden bg-slate-900 py-20 sm:py-28">
  <!-- Grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.05)_1px,transparent_1px)] bg-[size:64px_64px]"></div>

  <!-- Glow blobs -->
  <div class="absolute top-1/4 -left-48 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 -right-48 w-96 h-96 bg-violet-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">

    <!-- Badge -->
    <div class="mb-6">
      <span class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold px-4 py-1.5 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Free 30-day trial — no credit card required
      </span>
    </div>

    <!-- Headline block — fully centred -->
    <div class="w-full max-w-4xl text-center mb-10">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight tracking-tight mb-6">
        The POS that keeps working<br class="hidden sm:block" />
        <span class="text-emerald-400">— even when the internet doesn't.</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed mb-10">
        A modern, offline-first point of sale for retail, restaurant, and grocery.
        One platform for your whole team.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={APP_URL}
          class="w-full sm:w-auto px-8 py-4 bg-emerald-500 text-white font-bold text-base rounded-xl hover:bg-emerald-600 shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/40 hover:scale-[1.02] transition-all duration-150"
        >
          Start free trial
        </a>
        <a
          href="#business-type"
          class="w-full sm:w-auto flex items-center justify-center gap-2 px-8 py-4 border border-slate-700 text-slate-300 font-semibold text-base rounded-xl hover:border-slate-600 hover:text-white transition-all duration-150"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8"/>
          </svg>
          See how it works
        </a>
      </div>
    </div>

    <!-- Mock POS UI — sits below the text, never overlaps -->
    <div class="relative w-full max-w-4xl mt-6">

      <!-- Floating chip — top right, inside the mockup zone -->
      <div class="absolute -top-4 right-4 sm:right-8 z-10 bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 shadow-xl flex items-center gap-2">
        <span class="text-xs font-semibold text-slate-200">3 branches synced</span>
        <span class="text-emerald-400">✓</span>
      </div>

      <!-- Device frame -->
      <div class="relative bg-slate-800 rounded-2xl border border-slate-700 shadow-2xl overflow-hidden">
        <!-- Browser chrome bar -->
        <div class="flex items-center gap-2 px-4 py-3 bg-slate-800 border-b border-slate-700">
          <div class="flex gap-1.5 shrink-0">
            <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/70"></div>
          </div>
          <div class="flex-1 mx-4 flex justify-center">
            <div class="bg-slate-700 rounded-md px-3 py-1 text-xs text-slate-400 w-48 text-center">
              app.startpos.ph/pos
            </div>
          </div>
        </div>

        <!-- Real POS Interface Diagram -->
        <POSInterface class="w-full" />
      </div>

      <!-- Floating chip — bottom left -->
      <div class="absolute -bottom-4 left-4 sm:left-8 bg-slate-800 border border-emerald-500/30 rounded-xl px-4 py-2.5 shadow-xl flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs font-semibold text-slate-200">Working offline</span>
      </div>

    </div>

    <!-- Extra bottom breathing room for the bottom chip -->
    <div class="h-8 w-full"></div>

  </div>
</section>
